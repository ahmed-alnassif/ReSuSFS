    <string name="susfs_sus_paths_title">Sus Percorsi</string>
    <string name="susfs_sus_paths_desc">Nasconde solo la lettura/percorsi statici tramite add_sus_path. Efficace solo per processi umounted con uid ≥ 10000.</string>
    <string name="susfs_sus_paths_loop_title">Sus Paths (Loop)</string>
    <string name="susfs_sus_paths_loop_desc">Nasconde i percorsi spesso modificati/ricreati tramite add_sus_path_loop, re-flagged su ogni spawn di zygote.</string>
    <string name="susfs_sus_maps_title">Sus Maps</string>
    <string name="susfs_sus_maps_desc">Nasconde i file di libreria mmapped da /proc/self/maps e le relative interfacce tramite add_sus_map.</string>
    <string name="susfs_kstat_paths_title">Sus Kstat</string>
    <string name="susfs_kstat_paths_desc">Spoofs file informazioni stat per i percorsi che vengono collegati montati, in scena presto e impegnati in ritardo.</string>
    <string name="susfs_open_redirect_title">Apri Reindirizzamento</string>
    <string name="susfs_open_redirect_desc">Reindirizza un percorso di destinazione aperto a un percorso definito dall'utente per uno schema uid scelto.</string>
    <string name="susfs_uname_title">Lo Stesso Spoof</string>
    <string name="susfs_uname_desc">Spoofs il rilascio del kernel e la versione segnalati a tutti i processi.</string>
    <string name="susfs_cmdline_title">Cmdline / Bootconfig</string>
    <string name="susfs_cmdline_desc">Consente il contenuto di /proc/cmdline o /proc/bootconfig da un file preparato.</string>
