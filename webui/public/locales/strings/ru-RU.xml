    <!-- SuSFS config boxes -->
    <string name="susfs_sus_paths_title">Пути Sus</string>
    <string name="susfs_sus_paths_desc">Скрывает только чтение/статические пути через add_sus_path. Эффективно только для пунктирных процессов с uid ≥ 10000.</string>
    <string name="susfs_sus_paths_loop_title">Пути Sus (цикл)</string>
    <string name="susfs_sus_paths_loop_desc">Скрывает часто модифицированные/воссоздаваемые пути через add_sus_path_loop, повторно помеченные на каждом спавне зигота.</string>
    <string name="susfs_sus_maps_title">Sus Maps</string>
    <string name="susfs_sus_maps_desc">Скрывает mmapped файлы библиотеки из /proc/self/maps и связанных интерфейсов через add_sus_map.</string>
    <string name="susfs_kstat_paths_title">Sus Kstat</string>
    <string name="susfs_kstat_paths_desc">Сбрасывает статистику файла для пути, которые монтируются, поставляются рано и поздно.</string>
    <string name="susfs_open_redirect_title">Открыть перенаправление</string>
    <string name="susfs_open_redirect_desc">Перенаправляет открытый путь к указанному пользователем пути для выбранной схемы uid.</string>
    <string name="susfs_uname_title">Uname Spoof</string>
    <string name="susfs_uname_desc">Подменяет выпуск и версию ядра для всех процессов.</string>
    <string name="susfs_cmdline_title">Cmdline / Bootconfig</string>
    <string name="susfs_cmdline_desc">Заменяет содержимое /proc/cmdline или /proc/bootconfig из подготовленного файла.</string>
