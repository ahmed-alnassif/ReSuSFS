    <string name="susfs_sus_paths_title">Διαδρομές Sus</string>
    <string name="susfs_sus_paths_desc">Κρύβει μόνο για ανάγνωση/στατικές διαδρομές μέσω του add_sus_path. Αποτελεσματικό μόνο για τιτλοποιημένες διεργασίες με uid ≥ 10000.</string>
    <string name="susfs_sus_paths_loop_title">Διαδρομές Sus (Βρόχος)</string>
    <string name="susfs_sus_paths_loop_desc">Αποκρύπτει συχνά τροποποιημένες/αναδημιουργημένες διαδρομές μέσω του add_sus_path_loop, με εκ νέου επισήμανση σε κάθε ζυγωτό spawn.</string>
    <string name="susfs_sus_maps_title">Sus Maps</string>
    <string name="susfs_sus_maps_desc">Αποκρύπτει αρχεία βιβλιοθήκης από /proc/self/maps και σχετικές διεπαφές μέσω add_sus_map.</string>
    <string name="susfs_kstat_paths_title">Sus Kstat</string>
    <string name="susfs_kstat_paths_desc">Spoofs αρχείο stat πληροφορίες για μονοπάτια που παίρνουν προσαρτημένα, σκηνοθετούνται νωρίς και διαπράττονται αργά.</string>
    <string name="susfs_open_redirect_title">Άνοιγμα Ανακατεύθυνσης</string>
    <string name="susfs_open_redirect_desc">Ανακατευθύνει μια ανοιγμένη διαδρομή στόχου σε μια καθορισμένη από το χρήστη διαδρομή για ένα επιλεγμένο σχήμα uid.</string>
    <string name="susfs_uname_title">Uname Spoof</string>
    <string name="susfs_uname_desc">Διορθώνει την έκδοση και έκδοση του πυρήνα που αναφέρονται σε όλες τις διεργασίες.</string>
    <string name="susfs_cmdline_title">Cmdline / Bootconfig</string>
    <string name="susfs_cmdline_desc">Spoofs το περιεχόμενο του /proc/cmdline ή /proc/bootconfig από ένα έτοιμο αρχείο.</string>
