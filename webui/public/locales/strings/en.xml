    <!-- Toggles -->
    <string name="toggles_title">Toggles</string>
    <string name="toggles_description">Simple kernel flags applied via hide_sus_mnts_for_non_su_procs, enable_log and enable_avc_log_spoofing.</string>
    <string name="toggle_hide_mnts">Hide Mounts</string>
    <string name="toggle_hide_mnts_desc">Applied in post-fs-data or boot-completed, once mounts have settled for user processes.</string>
    <string name="toggle_enable_log">Enable SuSFS Log</string>
    <string name="toggle_enable_log_desc">Turns on susfs' own kernel logging.</string>
    <string name="toggle_avc_spoof">Spoof AVC 'su' Context</string>
    <string name="toggle_avc_spoof_desc">Hides the su domain from AVC log enumeration.</string>
