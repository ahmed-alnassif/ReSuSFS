    <string name="susfs_sus_paths_title">Caminhos de Sus</string>
    <string name="susfs_sus_paths_desc">Oculta caminhos somente leitura/estática via add_sus_path. Só é eficaz para processos acumulados com uid ≥ 10000.</string>
