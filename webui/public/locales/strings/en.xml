    <!-- SuSFS config boxes -->
    <string name="susfs_sus_paths_title">Sus Paths</string>
    <string name="susfs_sus_paths_desc">Hides read-only/static paths via add_sus_path. Only effective for umounted processes with uid ≥ 10000.</string>
    <string name="susfs_sus_paths_loop_title">Sus Paths (Loop)</string>
    <string name="susfs_sus_paths_loop_desc">Hides frequently modified/recreated paths via add_sus_path_loop, re-flagged on every zygote spawn.</string>
    <string name="susfs_sus_maps_title">Sus Maps</string>
    <string name="susfs_sus_maps_desc">Hides mmapped library files from /proc/self/maps and related interfaces via add_sus_map.</string>
    <string name="susfs_kstat_paths_title">Sus Kstat</string>
    <string name="susfs_kstat_paths_desc">Spoofs file stat info for paths that get bind mounted, staged early and committed late.</string>
    <string name="susfs_open_redirect_title">Open Redirect</string>
    <string name="susfs_open_redirect_desc">Redirects an opened target path to a user-defined path for a chosen uid scheme.</string>
    <string name="susfs_uname_title">Uname Spoof</string>
    <string name="susfs_uname_desc">Spoofs the kernel release and version reported to all processes.</string>
    <string name="susfs_cmdline_title">Cmdline / Bootconfig</string>
    <string name="susfs_cmdline_desc">Spoofs the content of /proc/cmdline or /proc/bootconfig from a prepared file.</string>
